{
  "name": "fenmoai",
  "version": "1.0.0",
  "description": "FenmoAI - MERN Stack Application",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"npm run dev --prefix client\" --names \"server,client\" --prefix-colors \"cyan,magenta\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client",
    "start": "cd server && node index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}